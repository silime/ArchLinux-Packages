prepare() {
  cd ModemManager

  git apply ../fix-qcom-soc-dual-sim-reprobe-loop.patch
  # Preserve the test left untracked by a previous git-apply build.
  if [[ -f src/tests/test-netlink.c ]] &&
     ! git ls-files --error-unmatch src/tests/test-netlink.c >/dev/null 2>&1; then
    mv src/tests/test-netlink.c "src/tests/test-netlink.c.pre-prepare-$(date +%s)"
  fi
  git apply ../fix-netlink-transaction-use-after-free.patch

  # Fix gtk-doc build
  if ! git merge-base --is-ancestor 1ec2b86239c3686e22034baae0068bd5d52779ae HEAD; then
    git cherry-pick -n 1ec2b86239c3686e22034baae0068bd5d52779ae
  fi

  # Fix for Fibocom modems
  # https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager/-/issues/1
  if ! git merge-base --is-ancestor 018e44084825ab294ad2b5d5b301d2b9e2577eb1 HEAD; then
    git cherry-pick -n 018e44084825ab294ad2b5d5b301d2b9e2577eb1
  fi
}

build() {
  local meson_options=(
    -D dbus_policy_dir=/usr/share/dbus-1/system.d
    -D dist_version="\"$pkgver-$pkgrel\""
    -D gtk_doc=true
    -D polkit=permissive
    -D vapi=true
  )

  if [[ -f build/meson-private/coredata.dat ]]; then
    meson_options+=(--reconfigure)
  fi
  arch-meson ModemManager build "${meson_options[@]}"
  meson compile -C build
}

check() {
  python "$srcdir/test-qmi-uim-primary.py" "$srcdir/qmi-uim-primary"
  meson test -C build --suite daemon --print-errorlogs
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_modemmanager() {
  install=modemmanager.install
  license=(GPL-2.0-or-later)
  depends+=(
    "libmm-glib=$pkgver-$pkgrel" libmm-glib.so
    libgudev-1.0.so
    libg{lib,object,io,module}-2.0.so
    libmbim-glib.so
    libqmi-glib.so
    libsystemd.so
  )
  optdepends=(
    'usb_modeswitch: install if your modem shows up as a storage drive'
  )

  meson install -C build --destdir "$pkgdir"

  install -Dm755 "$srcdir/qmi-uim-primary" "$pkgdir/usr/lib/ModemManager/qmi-uim-primary"
  install -Dm644 "$srcdir/10-qmi-uim-primary.conf" "$pkgdir/usr/lib/systemd/system/ModemManager.service.d/10-qmi-uim-primary.conf"
  install -Dm644 "$srcdir/78-mm-qcom-sm8550.rules" "$pkgdir/usr/lib/udev/rules.d/78-mm-qcom-sm8550.rules"

  install -Dm755 "$srcdir/qcom-ims-prepare" "$pkgdir/usr/lib/ModemManager/qcom-ims-prepare"
  install -Dm644 "$srcdir/11-qcom-ims-prepare.conf" "$pkgdir/usr/lib/systemd/system/ModemManager.service.d/11-qcom-ims-prepare.conf"

  cd "$pkgdir"
  _pick libmm usr/include
  _pick libmm usr/lib/girepository-1.0
  _pick libmm usr/lib/libmm-glib.so*
  _pick libmm usr/lib/pkgconfig
  _pick libmm usr/share/gir-1.0
  _pick libmm usr/share/vala
  _pick docs usr/share/gtk-doc
}

package_libmm-glib() {
  pkgdesc="ModemManager library"
  license=(LGPL-2.1-or-later)
  depends=(
    glib2 libg{lib,object,io}-2.0.so
    glibc
    libgcc
  )
  provides=(libmm-glib.so)

  mv libmm/* "$pkgdir"
}

package_modemmanager-docs() {
  pkgdesc+=" (documentation)"
  depends=()

  mv docs/* "$pkgdir"
}

