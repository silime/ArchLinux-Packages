post_install() {
  systemctl disable --now meizu20inf-uim-primary.timer >/dev/null 2>&1 || true
  systemctl disable --now qmi-uim-primary.timer >/dev/null 2>&1 || true
  for legacy in /etc/systemd/system/ModemManager.service.d/11-meizu20inf-ims-prepare.conf /usr/local/libexec/meizu-prepare-ims; do
    if [ -f "$legacy" ]; then
      mv "$legacy" "$legacy.pre-qmi-migration.bak"
    fi
  done
  systemctl daemon-reload
}

post_upgrade() {
  post_install
}
