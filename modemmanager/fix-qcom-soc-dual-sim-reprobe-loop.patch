 /*****************************************************************************/
 
+static gboolean
+check_for_sim_swap_finish (MMIfaceModem  *self,
+                           GAsyncResult  *res,
+                           GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+check_for_sim_swap (MMIfaceModem        *self,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GTask *task;
+
+    /*
+     * Qualcomm smartphone firmware may expose multiple UIM applications and
+     * return an ICCID for a different slot when the modem transitions online.
+     * The generic checker interprets that as a physical SIM replacement and
+     * continuously disables and reprobes the modem. Slot changes are reported
+     * by the QMI UIM slot-status indications, so skip the identifier polling.
+     */
+    mm_obj_dbg (self, "skipping unreliable SIM identifier swap check");
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->check_for_sim_swap = check_for_sim_swap;
+    iface->check_for_sim_swap_finish = check_for_sim_swap_finish;
+}
+
