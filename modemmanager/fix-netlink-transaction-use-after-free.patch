diff --git a/src/tests/test-netlink.c b/src/tests/test-netlink.c
new file mode 100644
index 0000000..75b24d9
--- /dev/null
+++ b/src/tests/test-netlink.c
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <glib.h>
+#include <net/if.h>
+
+#include "mm-netlink.h"
+#include "mm-log-test.h"
+
+typedef struct {
+    GMainLoop  *loop;
+    GByteArray *address;
+    GError     *error;
+} TestContext;
+
+static void
+get_hwaddr_ready (MMNetlink    *netlink,
+                  GAsyncResult *result,
+                  TestContext  *ctx)
+{
+    ctx->address = mm_netlink_get_hwaddr_finish (netlink, result, &ctx->error);
+    g_main_loop_quit (ctx->loop);
+}
+
+static void
+test_get_hwaddr (void)
+{
+    MMNetlink  *netlink;
+    TestContext ctx = { 0 };
+    guint       ifindex;
+    guint       i;
+
+    ifindex = if_nametoindex ("lo");
+    g_assert_cmpuint (ifindex, >, 0);
+    netlink = g_object_new (MM_TYPE_NETLINK, NULL);
+    ctx.loop = g_main_loop_new (NULL, FALSE);
+
+    /* Repeat successful replies to exercise transaction destruction and reuse. */
+    for (i = 0; i < 32; i++) {
+        mm_netlink_get_hwaddr (netlink, ifindex, NULL,
+                               (GAsyncReadyCallback) get_hwaddr_ready, &ctx);
+        g_main_loop_run (ctx.loop);
+        g_assert_no_error (ctx.error);
+        g_assert_nonnull (ctx.address);
+        g_assert_cmpuint (ctx.address->len, ==, 6);
+        g_clear_pointer (&ctx.address, g_byte_array_unref);
+    }
+
+    g_main_loop_unref (ctx.loop);
+    g_object_unref (netlink);
+}
+
+static void
+test_get_hwaddr_invalid (void)
+{
+    MMNetlink  *netlink;
+    TestContext ctx = { 0 };
+
+    netlink = g_object_new (MM_TYPE_NETLINK, NULL);
+    ctx.loop = g_main_loop_new (NULL, FALSE);
+    mm_netlink_get_hwaddr (netlink, 0, NULL,
+                           (GAsyncReadyCallback) get_hwaddr_ready, &ctx);
+    g_main_loop_run (ctx.loop);
+    g_assert_null (ctx.address);
+    g_assert_error (ctx.error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT);
+    g_clear_error (&ctx.error);
+
+    g_main_loop_unref (ctx.loop);
+    g_object_unref (netlink);
+}
+
+int
+main (int argc, char **argv)
+{
+    g_test_init (&argc, &argv, NULL);
+    g_test_add_func ("/MM/netlink/get-hwaddr", test_get_hwaddr);
+    g_test_add_func ("/MM/netlink/get-hwaddr-invalid", test_get_hwaddr_invalid);
+    return g_test_run ();
+}
