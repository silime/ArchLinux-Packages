+static void set_speaker_profile(pa_context *ctx, const pa_card_info *info,
+                                int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    const gchar *port_name = operation->value ? operation->pulse->speaker_port :
+                                               operation->pulse->earpiece_port;
+    const pa_card_profile_info2 *best = NULL;
+    pa_operation *op = NULL;
+
+    if (eol || !info)
+        return;
+    for (guint i = 0; i < info->n_ports; i++) {
+        pa_card_port_info *port = info->ports[i];
+
+        if (g_strcmp0(port->name, port_name) != 0)
+            continue;
+        for (guint j = 0; j < port->n_profiles; j++) {
+            pa_card_profile_info2 *profile = port->profiles2[j];
+
+            if (profile->available &&
+                g_str_has_prefix(profile->name, SND_USE_CASE_VERB_VOICECALL) &&
+                (!best || profile->priority > best->priority))
+                best = profile;
+        }
+    }
+    if (best)
+        op = pa_context_set_card_profile_by_index(ctx, info->index, best->name,
+                                                  operation_complete_cb, operation);
+    if (op)
+        pa_operation_unref(op);
+    else
+        operation_complete_cb(ctx, 0, operation);
+}
+
+static gboolean restore_media_profile(gpointer data)
+{
+    CadPulseOperation *operation = data;
+    pa_operation *op;
+
+    if (operation->mode_serial != operation->pulse->mode_serial) {
+        operation_complete_cb(operation->pulse->ctx, 0, operation);
+        return G_SOURCE_REMOVE;
+    }
+
+    op = pa_context_get_card_info_by_index(operation->pulse->ctx,
+                                          operation->pulse->card_id,
+                                          set_card_profile, operation);
+    if (op)
+        pa_operation_unref(op);
+    else
+        operation_complete_cb(operation->pulse->ctx, 0, operation);
+    return G_SOURCE_REMOVE;
+}
