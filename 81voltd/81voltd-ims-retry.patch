 	conn->local_id = local_id;
 }
 
+static void connect_bearer(QVDConnection *conn);
+
+static gboolean retry_connect(gpointer data)
+{
+	QVDConnection *conn = QVD_CONNECTION(data);
+
+	conn->connect_retry_source = 0;
+	if (conn->requested && conn->bearer != NULL)
+		connect_bearer(conn);
+
+	return G_SOURCE_REMOVE;
+}
+
 static void on_connect(GObject *obj, GAsyncResult *res, gpointer data)
 {
 	QVDConnection *conn = QVD_CONNECTION(data);
@@ -148,21 +171,43 @@ static void on_connect(GObject *obj, GAsyncResult *res, gpointer data)
 	mm_bearer_connect_finish(MM_BEARER(obj), res, &err);
 	if (err != NULL) {
 		g_printerr("Failed to connect: %s\n", err->message);
-		g_signal_emit(conn, conn_signals[CONNECT_ERR], 0, err);
+		if (conn->requested && conn->connect_attempts < CONNECT_RETRY_MAX_ATTEMPTS) {
+			g_warning("Retrying bearer connection in %u seconds (attempt %u/%u)",
+				  CONNECT_RETRY_INTERVAL_SECONDS,
+				  conn->connect_attempts + 1,
+				  CONNECT_RETRY_MAX_ATTEMPTS);
+			conn->connect_retry_source = g_timeout_add_seconds_full(
+				G_PRIORITY_DEFAULT,
+				CONNECT_RETRY_INTERVAL_SECONDS,
+				retry_connect,
+				g_object_ref(conn),
+				g_object_unref);
+		} else {
+			g_signal_emit(conn, conn_signals[CONNECT_ERR], 0, err);
+		}
 		g_clear_error(&err);
+	} else {
+		conn->connect_attempts = 0;
 	}
 
 	g_object_unref(conn);
 }
 
+static void connect_bearer(QVDConnection *conn)
+{
+	conn->connect_attempts++;
+	mm_bearer_connect(conn->bearer, NULL, on_connect, g_object_ref(conn));
+}
+
