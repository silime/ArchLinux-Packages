# Maintainer: Chalkin <chalkin@yeah.net>
pkgname=q6voiced
pkgver=0.3.1
_commit=21061751b80850e37de371d61a039cc2297999e0
pkgrel=2
pkgdesc="Enable q6voice audio when call is performed with oFono/ModemManager"
arch=("aarch64")
license=(MIT)
makedepends=(git meson)
depends=(alsa-lib dbus)
source=("git+https://gitlab.postmarketos.org/postmarketOS/q6voiced.git#commit=${_commit}"
	q6voiced.conf
	q6voiced-pcm-format-negotiation.patch)

sha256sums=('SKIP'
            '960805dca70f7173c6e8b86e14ccb4297c23924b9c593ecd9cf4c933785f4942'
            'cfa70b00d9f817b7c1e1342cab5f80d6dfa6c039b61bf0d69c007417690145a8')

prepare() {
	cd q6voiced
	patch -Np1 -i ../q6voiced-pcm-format-negotiation.patch
}

build() {
	arch-meson q6voiced build \
		-Dopenrc=disabled \
		-Dsystemd=enabled
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 q6voiced.conf "$pkgdir/usr/share/q6voiced/q6voiced.conf"
}
